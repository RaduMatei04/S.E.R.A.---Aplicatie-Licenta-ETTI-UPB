# Copiaza acest fisier in `.env` si ajusteaza ce e nevoie.
# `.env` este ignorat de git.

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=sera
POSTGRES_USER=sera
# Valoare de dezvoltare. Schimb-o daca baza devine accesibila din afara masinii.
POSTGRES_PASSWORD=sera

# --- MQTT -------------------------------------------------------------------
# Brokerul ruleaza in proiectul compose `infra` (sera-code/infra/docker-compose.yml),
# pe reteaua `infra_default`. `mosquitto` este numele de serviciu de acolo, acelasi
# pe care il foloseste si Telegraf.
SERA_MQTT_URL=tcp://mosquitto:1883
SERA_MQTT_TOPIC=sera/senzori
SERA_MQTT_CLIENT_ID=sera-backend

# --- Backend ----------------------------------------------------------------
# Cat de des se scrie in Postgres. ESP32 publica la 1 Hz; pe WebSocket se trimite
# fiecare mesaj, indiferent de valoarea de aici.
SERA_PERSIST_INTERVAL=5s
# Cate zile se pastreaza citirile brute. Agregatele orare raman definitiv.
SERA_RETENTION_DAYS=30
SERA_CORS_ORIGINS=http://localhost:5173

# --- Frontend ---------------------------------------------------------------
VITE_API_URL=http://localhost:8081
